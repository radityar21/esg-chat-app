# Platform API (CDK output PlatformApiUrl). Leave empty to run on bundled demo data.
VITE_PLATFORM_API_URL=
# CDK output PlatformFunctionUrl. Used for long calls (agent chat, regulatory scan) because API Gateway cuts at 30 s.
VITE_AGENT_CHAT_URL=
# Same value as `cdk deploy -c apiKey=...`. It ships in the browser bundle, so it is a demo gate, not real authentication.
VITE_PLATFORM_API_KEY=
